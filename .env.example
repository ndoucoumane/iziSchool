# ==============================================================================
# iziSchool — Variables d'environnement pour le développement local
# Copier ce fichier vers .env avant de lancer l'application : cp .env.example .env
# ==============================================================================

# Profil Spring Boot actif & Port
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8081

# Authentification Keycloak (Désactivée par défaut pour faciliter le développement local)
# Mettre à 'true' dès que vous souhaitez tester avec de vrais JWT Keycloak
AUTH_ENABLED=true
DEV_SEED_ENABLED=true
DEV_SCHOOL_NAME="École Pilote iziSchool"
DEV_SCHOOL_CODE=PILOTE-01
DEV_ADMIN_EMAIL=admin@izischool.com
DEV_ADMIN_FIRSTNAME=Admin
DEV_ADMIN_LASTNAME=Principal
DEV_ADMIN_KEYCLOAK_ID=dev-default-admin-id

# Base de données PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/izischool_db
DB_USERNAME=izischool_user
DB_PASSWORD=izischool_secret_password
DB_NAME=izischool_db

# Cache & Files Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentification & Identité Keycloak (Port 8180, Realm iziSchool)
KEYCLOAK_PORT=8180
KEYCLOAK_SERVER_URL=http://localhost:8180
KEYCLOAK_REALM=iziSchool
KEYCLOAK_CLIENT_ID=izischool-backend
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/iziSchool
KEYCLOAK_JWK_SET_URI=http://localhost:8180/realms/iziSchool/protocol/openid-connect/certs
KEYCLOAK_OPENID_CONFIG_URL=http://localhost:8180/realms/iziSchool/.well-known/openid-configuration
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Paramètres Métier par Défaut
DEFAULT_CURRENCY=XOF
DEFAULT_TIMEZONE=UTC

# Providers Mobile Money (Optionnel pour le MVP / Mockés)
WAVE_API_URL=https://api.wave.com/v1
WAVE_API_KEY=mock_wave_key
ORANGE_MONEY_API_URL=https://api.orange.com/om/v1
ORANGE_MONEY_API_KEY=mock_om_key
